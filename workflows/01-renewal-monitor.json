              "value": "={{ $json[\"Email\"] }}",
              "type": "string"
            },
            {
              "id": "74868f13-2361-41a4-ba1c-8f62ce467b4d",
              "name": "=alert_status",
              "value": "={{ $json[\"Days to Notice Deadline\"] < 0 ? \"OVERDUE\" : $json[\"Days to Notice Deadline\"] < 30 ? \"URGENT\" : \"UPCOMING\" }}",
              "type": "string"
            },
            {
              "id": "c82ad380-7bf0-4156-a815-1aca68f483b2",
              "name": "=alert_subject",
              "value": "={{  $json[\"Days to Notice Deadline\"] < 0 ? \"OVERDUE: \" + $json[\"Contract ID\"] + \" – \" + $json[\"Supplier\"] + \" renewal decision\" : $json[\"Days to Notice Deadline\"] < 30 ? \"URGENT: \" + $json[\"Contract ID\"] + \" – \" + $json[\"Supplier\"] + \" renewal decision\" : \"Action required: \" + $json[\"Contract ID\"] + \" – \" + $json[\"Supplier\"] + \" renewal decision\" }}",
              "type": "string"
            },
            {
              "id": "98d848fb-71a5-4670-a9ba-c80b18e9dff9",
              "name": "=alert_body",
              "value": "={{ `Hi ${$json[\"Business Owner\"]},\n\nContract ${$json[\"Contract ID\"]} with ${$json[\"Supplier\"]} requires a renewal decision.\n\nExpiry date: ${$json[\"Expiry Date\"]}\nNotice deadline: ${$json[\"Notice Deadline\"]}\nDays to notice deadline: ${$json[\"Days to Notice Deadline\"]}\nCurrent contract value: ${new Intl.NumberFormat(\"en-GB\", { style: \"currency\", currency: \"GBP\", maximumFractionDigits: 0 }).format($json[\"Current Contract Value\"])}\nRisk tier: ${$json[\"Risk Tier\"]}\n\nPlease review the contract and record one of the following decisions:\n\n• Renew unchanged\n• Renew with amendments\n• Do not renew\n• Terminate\n\nContract Manager/Associate: ${$json[\"Contract Manager/Associate\"]}\n\nThis notification was generated automatically by ContractOps.` }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
