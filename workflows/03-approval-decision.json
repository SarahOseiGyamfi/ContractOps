      "id": "b68d37da-f809-46e5-b6d6-cf3e055d60d8",
      "name": "Update Approval Decision"
    },
    {
      "parameters": {
        "jsCode": "const approvals = $input.all().map(item => ({ ...item.json }));\n\n// This is the row that Excel has just successfully updated.\nconst updatedApproval =\n  $('Update Approval Decision').first().json;\n\n// Replace the stale version of that approval in the fresh sibling read\n// with the actual output from the successful update.\nconst currentApprovals = approvals.map(row => {\n  if (\n    row['Approval Request ID'] ===\n    updatedApproval['Approval Request ID']\n  ) {\n    return {\n      ...row,\n      ...updatedApproval\n    };\n  }\n\n  return row;\n});\n\nconst statuses = currentApprovals.map(\n  row => row['Approval Status']\n);\n\nconst amendmentRequestId =\n  currentApprovals[0]['Amendment Request ID'];\n\nconst approvedCount =\n  statuses.filter(status => status === 'Approved').length;\n\nconst pendingCount =\n  statuses.filter(status => status === 'Pending').length;\n\nconst rejectedCount =\n  statuses.filter(status => status === 'Rejected').length;\n\nlet overallApprovalStatus;\nlet documentStatus;\n\nif (rejectedCount > 0) {\n  overallApprovalStatus = 'Rejected';\n  documentStatus = 'Blocked';\n} else if (pendingCount > 0) {\n  overallApprovalStatus = 'Pending';\n  documentStatus = 'Not Ready';\n} else {\n  overallApprovalStatus = 'Approved';\n  documentStatus = 'Ready for Generation';\n}\n\nreturn [\n  {\n    json: {\n      amendment_request_id: amendmentRequestId,\n      total_approvals: currentApprovals.length,\n      approved_count: approvedCount,\n      pending_count: pendingCount,\n      rejected_count: rejectedCount,\n      overall_approval_status: overallApprovalStatus,\n      document_status: documentStatus\n    }\n  }\n];"
      },
