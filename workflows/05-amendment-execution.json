      "name": "Audit Log Entry"
    },
    {
      "parameters": {
        "method": "PATCH",
        "url": "={{\n'https://graph.microsoft.com/v1.0/me/drive/root:/Documents/ContractOps/ContractOps_Demo.xlsx:/workbook/worksheets(\\'Contract Register\\')/range(address=\\'H' +\n(\n  $('Get rows1').all().findIndex(\n    item => item.json['Contract ID'] === $json['Contract ID']\n  ) + 2\n) +\n':V' +\n(\n  $('Get rows1').all().findIndex(\n    item => item.json['Contract ID'] === $json['Contract ID']\n  ) + 2\n) +\n'\\')'\n}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "microsoftExcelOAuth2Api",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n{\n  values: [[\n\n    // H - Current Contract Value\n    Number(\n      $('Find Submitted Amendment')\n        .first()\n        .json['Proposed Contract Value']\n    ),\n\n    // I - Start Date\n    null,\n\n    // J - Fully Executed Date\n    null,\n\n    // K - Expiry Date\n    Number(\n      $('Find Submitted Amendment')\n        .first()\n        .json['Proposed Expiry Date']\n    ),\n\n    // L - Notice Period\n    null,\n\n    // M - Notice Deadline FORMULA - preserve\n    null,\n\n    // N - Days to Notice Deadline FORMULA - preserve\n    null,\n\n    // O - Auto-Renewal\n    null,\n\n    // P - Personal Data\n    $('Find Submitted Amendment')\n      .first()\n      .json['Proposed Personal Data'],\n\n    // Q - Supplier Access\n    null,\n\n    // R - Critical Service\n    null,\n\n    // S - Risk Tier FORMULA - preserve\n    null,\n\n    // T - Status\n    null,\n\n    // U - Current Version\n    Number($json['Current Version']) + 1,\n\n    // V - Last Amended Date\n    Date.UTC(\n      Number(\n        $('On form submission')\n          .first()\n          .json['Execution Date']\n          .slice(0,4)\n      ),\n      Number(\n        $('On form submission')\n          .first()\n          .json['Execution Date']\n          .slice(5,7)\n      ) - 1,\n      Number(\n        $('On form submission')\n          .first()\n          .json['Execution Date']\n          .slice(8,10)\n      )\n    ) / 86400000 + 25569\n\n  ]]\n}\n}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
