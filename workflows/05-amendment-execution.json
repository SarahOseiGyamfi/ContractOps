    },
    {
      "parameters": {
        "resource": "table",
        "workbook": {
          "__rl": true,
          "value": "REPLACE_WITH_ONEDRIVE_WORKBOOK_ID",
          "mode": "id"
        },
        "worksheet": {
          "__rl": true,
          "value": "{00000000-0001-0000-0100-000000000000}",
          "mode": "list",
          "cachedResultName": "Audit Log"
        },
        "table": {
          "__rl": true,
          "value": "{00000000-000C-0000-FFFF-FFFF01000000}",
          "mode": "list",
          "cachedResultName": "AuditLog"
        },
        "fieldsUi": {
          "values": [
            {
              "column": "Timestamp",
              "fieldValue": "={{\nDate.UTC(\n  $now.setZone(\"Europe/London\").year,\n  $now.setZone(\"Europe/London\").month - 1,\n  $now.setZone(\"Europe/London\").day,\n  $now.setZone(\"Europe/London\").hour,\n  $now.setZone(\"Europe/London\").minute,\n  $now.setZone(\"Europe/London\").second\n) / 86400000 + 25569\n}}"
            },
            {
              "column": "Contract ID",
              "fieldValue": "={{ $('Find Submitted Amendment').first().json['Contract ID'] }}"
            },
            {
              "column": "Event",
              "fieldValue": "Amendment Executed"
            },
            {
              "column": "Triggered By",
              "fieldValue": "={{ $('On form submission').first().json['Executed By'] }}"
            },
            {
              "column": "Outcome / Detail",
              "fieldValue": "={{ (() => {\n\nconst amendment = $('Find Submitted Amendment').first().json;\nconst contract = $('Find Contract to Update').first().json;\n\nconst currentValue = Number(contract[\"Current Contract Value\"]);\nconst proposedValue = Number(amendment[\"Proposed Contract Value\"]);\n\nlet valueText;\n\nif (proposedValue > currentValue) {\n  valueText =\n    `Contract value increased from £${currentValue.toLocaleString(\"en-GB\")} ` +\n    `to £${proposedValue.toLocaleString(\"en-GB\")}.`;\n} else if (proposedValue < currentValue) {\n  valueText =\n    `Contract value decreased from £${currentValue.toLocaleString(\"en-GB\")} ` +\n    `to £${proposedValue.toLocaleString(\"en-GB\")}.`;\n} else {\n  valueText =\n    `Contract value remains £${proposedValue.toLocaleString(\"en-GB\")}.`;\n}\n\nconst currentPD = amendment[\"Current Personal Data\"];\nconst proposedPD = amendment[\"Proposed Personal Data\"];\n\nlet personalDataText;\n\nif (currentPD === \"Yes\" && proposedPD === \"Yes\") {\n  personalDataText = \"Personal data processing remains included.\";\n} else if (currentPD === \"No\" && proposedPD === \"Yes\") {\n  personalDataText = \"Personal data processing has been introduced.\";\n} else if (currentPD === \"Yes\" && proposedPD === \"No\") {\n  personalDataText = \"Personal data processing has been removed.\";\n} else {\n  personalDataText = \"Personal data processing remains excluded.\";\n}\n\nconst newVersion = Number(contract[\"Current Version\"]) + 1;\n\nconst expirySerial = Number(amendment[\"Proposed Expiry Date\"]);\nconst expiryDate = new Date((expirySerial - 25569) * 86400 * 1000);\n\nconst expiryText = expiryDate.toLocaleDateString(\"en-GB\", {\n  day: \"numeric\",\n  month: \"long\",\n  year: \"numeric\",\n  timeZone: \"UTC\"\n});\n\nreturn (\n  `Amendment ${amendment[\"Amendment Request ID\"]} executed. ` +\n  `${valueText} ` +\n  `${personalDataText} ` +\n  `Contract version ${newVersion} expires on ${expiryText}.`\n);\n\n})() }}"
            }
          ]
        },
        "options": {}
      },
